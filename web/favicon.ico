<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00F3FF"/>
      <stop offset="100%" stop-color="#6366F1"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#00F3FF" flood-opacity="0.6"/>
    </filter>
  </defs>
  <!-- Rounded cyber-industrial squircle -->
  <rect x="4" y="4" width="56" height="56" rx="14" fill="#0A1120" stroke="url(#grad)" stroke-width="2.5" filter="url(#glow)"/>
  <!-- Causalyn 'C' Monogram -->
  <text x="50%" y="54%" text-anchor="middle" dominant-baseline="central" font-family="'Outfit', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" font-weight="900" font-size="34" fill="url(#grad)" letter-spacing="-1">C</text>
  <!-- Small equilibrium dot in safe emerald -->
  <circle cx="48" cy="16" r="3.5" fill="#10B981"/>
</svg>
